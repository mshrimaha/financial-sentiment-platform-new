# ---------------------------------------------------------------------------
# Backend environment (copy to backend/.env)
# ---------------------------------------------------------------------------
# Local prototype persistence (default). Leave as-is for SQLite.
DATABASE_URL=sqlite:///./financial_platform.db

# JWT signing — CHANGE THIS in any shared or deployed environment
SECRET_KEY=change-me-to-a-long-random-string

# Where uploaded images/audio/video and generated reports are written
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Supabase (production). Leave blank to run fully locally.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Postgres connection strings for Prisma / Supabase (see database/prisma/schema.prisma)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
