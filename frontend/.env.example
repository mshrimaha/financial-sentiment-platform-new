# ---------------------------------------------------------------------------
# Frontend environment (copy to frontend/.env.local)
# ---------------------------------------------------------------------------
# The Next.js server proxies /be/* to this backend origin, so the browser only
# ever makes same-origin requests. Using 127.0.0.1 avoids IPv6 ::1 mismatches on Windows.
BACKEND_URL=http://127.0.0.1:8000

# Optional: only if you bypass the proxy and call the API directly (not recommended)
# NEXT_PUBLIC_API_URL=
